# ------------------------------------------------------------------------
# Skyra Data — Backend environment
# ------------------------------------------------------------------------
# This file lists EVERY secret the platform needs. Secrets live ONLY here,
# on the backend — never in the Expo mobile client.
# Copy to `.env` and fill in real values for staging/production.
# ------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins for CORS (the mobile app uses native
# fetch and is not origin-bound; this matters for any web dashboard).
CORS_ORIGINS=*

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_DAYS=7

# Admin dashboard login (served at /admin). CHANGE THESE before any deploy.
ADMIN_EMAIL=admin@skyradata.local
ADMIN_PASSWORD=admin1234
# Where JSON-persisted data (catalogue, settings) is written (local-file mode).
DATA_DIR=data
# Postgres connection string. When set, ALL data persists in the database
# instead of local files (required on hosts with a temporary disk, e.g. Render
# free tier). Get a free one from Neon (neon.tech) or Supabase. Example:
# postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=
# Optional: shared secret for central SSO. If set, admin tokens signed with it
# are also accepted, so a central admin hub can manage Skyra with one login.
ADMIN_SSO_SECRET=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# When true, the OTP is returned in the API response and logged so you can test
# without a live SMS gateway. MUST be false in production.
OTP_DEV_MODE=true

# Providers ---------------------------------------------------------------
# Which implementations to use: `mock` runs the full flow locally with no
# external accounts. Switch to a real id once credentials below are set.
PAYMENT_PROVIDER=mock          # mock | paystack | flutterwave
TELECOM_PROVIDER=mock          # mock | <your-aggregator>

# Paystack (only needed when PAYMENT_PROVIDER=paystack) --------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=       # usually the same secret key; used for HMAC verify
PAYSTACK_CALLBACK_URL=https://api.skyradata.example.com/webhooks/paystack

# Flutterwave (only needed when PAYMENT_PROVIDER=flutterwave) --------------
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Telecom / data aggregator (only needed for a real TELECOM_PROVIDER) ------
TELECOM_API_BASE_URL=
TELECOM_API_KEY=

# Pricing -----------------------------------------------------------------
# Flat processing fee added to every order, in GHS. Real deployments may
# compute this per payment method / provider instead.
PROCESSING_FEE_GHS=0.50

# USSD --------------------------------------------------------------------
# The Skyra short code feature-phone users dial. This is a placeholder until
# you rent a real short code from a USSD aggregator (Hubtel/Nsano/Africa's
# Talking). Surfaced to the app's "buy on a basic phone" screen and menu.
# Quoted so the trailing '#' is not treated as an inline comment.
USSD_SHORT_CODE="*789#"

# Network logos ------------------------------------------------------------
# URLs to APPROVED official carrier logo assets (PNG/SVG hosted over HTTPS).
# Only set these to assets you are licensed to display. Leave blank to use the
# app's neutral lettermark fallback.
LOGO_MTN_URL=
LOGO_TELECEL_URL=
LOGO_AT_URL=

# Mock behaviour ----------------------------------------------------------
# Milliseconds the mock providers take to move through each stage, and the
# share of mock fulfilments that fail (0-1) so failure paths are testable.
MOCK_STAGE_MS=1500
MOCK_FAILURE_RATE=0.12
